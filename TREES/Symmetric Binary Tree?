/**
 * Approach:
 * - Use Depth-First Search (DFS) to compare the left and right subtrees.
 * - If both nodes are null, they are symmetric.
 * - If only one node is null, they are not symmetric.
 * - If their values are different, they are not symmetric.
 * - Recursively compare the mirror positions of both subtrees.
 *
 * Time Complexity: O(N)
 * Space Complexity: O(H)
 */

class Solution {

    public boolean isSymmetric(TreeNode root) {

        if (root == null) return true;
        // An empty tree is symmetric.

        return isMirror(root.left, root.right);
        // Compare the left and right subtrees as mirrors.
    }

    public boolean isMirror(TreeNode left, TreeNode right) {

        if (left == null && right == null) {
            return true;
        }
        // If both nodes are null, they are symmetric.

        if (left == null || right == null) {
            return false;
        }
        // If only one node is null, they are not symmetric.

        if (left.val != right.val) {
            return false;
        }
        // If the values are different, they are not symmetric.

        return isMirror(left.left, right.right)
            && isMirror(left.right, right.left); 
//left.left   ↔   right.right
  left.right  ↔   right.left Both mirror comparisons must be true, so we use &&.
        // Compare the mirror positions of the two subtrees.
    }
}
