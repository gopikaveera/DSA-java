class MyStack {
     Queue<Integer> q1=new LinkedList<>();

    public void push(int x) {
        int s=q1.size();
        q1.add(x);
        for(int i=0;i<s;i++){
            q1.add(q1.poll());
            
        }
        
    }
    
    public int pop() {
        int n=q1.peek();
        q1.poll();
        return n;
        
    }
    
    public int top() {
        return q1.peek();
        
    }
    
    public boolean empty() {
        return q1.isEmpty();
        
    }
}
