class Solution {
    public boolean isValid(String s) {

        Stack<Character> st = new Stack<>(); // Create empty stack

        int n = s.length(); // Get string length

        for(int i = 0; i < n; i++) { // Traverse string

            // If opening bracket, push into stack
            if(s.charAt(i) == '(' ||
               s.charAt(i) == '{' ||
               s.charAt(i) == '[') {

                st.push(s.charAt(i));
            }

            // Closing bracket
            else {

                // No opening bracket available
                if(st.isEmpty())
                    return false;

                // Get top element
                char ch = st.peek();

                // Remove top element
                st.pop();

                // Check for mismatch
                if((s.charAt(i) == ')' && ch != '(') ||
                   (s.charAt(i) == '}' && ch != '{') ||
                   (s.charAt(i) == ']' && ch != '[')) {

                    return false;
                }
            }
        }

        // Stack should be empty at the end
        return st.isEmpty();
    }
}
Time Complexity: O(n). Single for loop used
Space Complexity: O(N). Stack space
