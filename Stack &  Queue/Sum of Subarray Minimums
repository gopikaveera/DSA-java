class Solution {

    // Returns the index of the Next Smaller Element (NSE) for every element
    private int[] findNSE(int[] arr) {

        int n = arr.length;                    // Store array size

        int[] ans = new int[n];                // ans[i] stores the index of NSE

        Stack<Integer> st = new Stack<>();     // Monotonic increasing stack (stores INDICES)

        // Traverse from right to left because we need the next smaller element
        for (int i = n - 1; i >= 0; i--) {

            // Remove all elements greater than or equal to current element
            // They can never become the next smaller element
            while (!st.isEmpty() && arr[st.peek()] >= arr[i]) {
                st.pop();
            }

            // If stack is not empty, top is NSE index
            // Otherwise, no smaller element exists, so store n
            ans[i] = !st.isEmpty() ? st.peek() : n;

            // Push current INDEX into stack
            st.push(i);
        }

        // Return the NSE index array
        return ans;
    }

    // Returns the index of the Previous Smaller or Equal Element (PSEE)
    private int[] findPSEE(int[] arr) {

        int n = arr.length;                    // Store array size

        int[] ans = new int[n];                // ans[i] stores PSEE index

        Stack<Integer> st = new Stack<>();     // Monotonic increasing stack (stores INDICES)

        // Traverse from left to right because we need previous smaller element
        for (int i = 0; i < n; i++) {

            // Remove only greater elements
            // Keep equal elements to avoid duplicate counting
            while (!st.isEmpty() && arr[st.peek()] > arr[i]) {
                st.pop();
            }

            // If stack is not empty, top is PSEE index
            // Otherwise store -1 (imaginary index before array starts)
            ans[i] = !st.isEmpty() ? st.peek() : -1;

            // Push current INDEX
            st.push(i);
        }

        // Return the PSEE index array
        return ans;
    }

    public int sumSubarrayMins(int[] arr) {

        int n = arr.length;                    // Array size

        int[] nse = findNSE(arr);              // Store NSE indices

        int[] psee = findPSEE(arr);            // Store PSEE indices

        int mod = (int)1e9 + 7;                // Required modulo

        int total = 0;                         // Stores final answer

        // Calculate contribution of every element
        for (int i = 0; i < n; i++) {

            // Number of possible starting positions
            int left = i - psee[i];

            // Number of possible ending positions
            int right = nse[i] - i;

            // Total subarrays where arr[i] is the minimum
            long freq = left * right * 1L;

            // Contribution of current element
            long val = (freq * arr[i]) % mod;

            // Add contribution to answer
            total = (int)((total + val) % mod);
        }

        // Return final answer
        return total;
    }
}


