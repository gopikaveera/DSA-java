class Solution {
    public boolean isPalindrome(String s) {
        // INIT → set two pointers
        int left = 0, right = s.length() - 1;
        // LOOP → process until pointers meet
        while (left < right) {
            // SKIP non-alphanumeric (keep moving until valid)
            while (left < right && !Character.isLetterOrDigit(s.charAt(left))) {
                left++;
            }
            // SKIP non-alphanumeric
            while (left < right && !Character.isLetterOrDigit(s.charAt(right))) {
                right--;
            }
            // CHECK → compare characters (case-insensitive)
            if (Character.toLowerCase(s.charAt(left)) != 
                Character.toLowerCase(s.charAt(right))) {
                return false;   // FAIL → not a palindrome
            }
            // MOVE → shrink window (VERY IMPORTANT)
            left++;
            right--;
        }
        // END → all pairs matched
        return true;
    }
}

TC:O(N)
SC:O(1)
