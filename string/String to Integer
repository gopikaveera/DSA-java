class Solution {

    public int myAtoi(String s) {

        // i -> used to traverse the string
        int i = 0;

        // n -> stores length of string
        int n = s.length();

        // =====================================
        // STEP 1 : SKIP LEADING SPACES
        // =====================================

        /*
           Example:
           "    42"

           Skip all spaces until digit/sign comes
        */

        while (i < n && s.charAt(i) == ' ') {
            i++;
        }

        // =====================================
        // STEP 2 : HANDLE SIGN
        // =====================================

        /*
           Default sign is positive
        */

        int sign = 1;

        /*
           Check whether current character is:
           '+' or '-'
        */

        if (i < n && (s.charAt(i) == '+' || s.charAt(i) == '-')) {

            // If negative sign comes
            if (s.charAt(i) == '-') {

                sign = -1;
            }

            // Move to next character
            i++;
        }

        // =====================================
        // STEP 3 : CONVERT STRING TO INTEGER
        // =====================================

        /*
           result stores final number
        */

        int result = 0;

        /*
           Continue loop while character is digit
        */

        while (i < n && Character.isDigit(s.charAt(i))) {

            // Convert character digit into integer

            /*
               Example:
               '7' - '0' = 7
            */

            int digit = s.charAt(i) - '0';

            // =====================================
            // STEP 4 : CHECK INTEGER OVERFLOW
            // =====================================

            /*
               Before doing:

               result = result * 10 + digit

               check whether overflow occurs
            */

            if (result > (Integer.MAX_VALUE - digit) / 10) {

                /*
                   If sign is positive:
                   return Integer.MAX_VALUE

                   If sign is negative:
                   return Integer.MIN_VALUE
                */

                return (sign == 1)
                        ? Integer.MAX_VALUE
                        : Integer.MIN_VALUE;
            }

            // =====================================
            // STEP 5 : BUILD THE NUMBER
            // =====================================

            /*
               Example:

               result = 12
               digit = 3

               12 * 10 + 3 = 123
            */

            result = result * 10 + digit;

            // Move to next character
            i++;
        }

        // =====================================
        // STEP 6 : RETURN FINAL ANSWER
        // =====================================

        return result * sign;
    }
}


