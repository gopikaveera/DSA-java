/**
 * Approach:
 * - Use Level Order Traversal (BFS) with a Queue.
 * - Traverse one level at a time.
 * - Maintain a boolean variable to track the direction.
 * - If direction is Left to Right,
 *   add the node at the end of the list.
 * - If direction is Right to Left,
 *   add the node at the beginning of the list.
 * - After processing one complete level,
 *   reverse the direction.
 *
 * Time Complexity: O(N)
 * - Every node is visited exactly once.
 *
 * Space Complexity: O(N)
 * - Queue + Answer List.
 */

class Solution {

    public List<List<Integer>> zigzagLevelOrder(TreeNode root) {

        // Stores the final zigzag traversal.
        List<List<Integer>> ans = new ArrayList<>();

        // Base Case:
        // If the tree is empty,
        // return an empty list.
        if (root == null)
            return ans;

        // Queue used for Level Order Traversal.
        Queue<TreeNode> q = new LinkedList<>();

        // Insert the root node.
        q.offer(root);

        // Initially traverse from Left to Right.
        boolean leftToRight = true;

        // Continue until all levels are processed.
        while (!q.isEmpty()) {

            // Number of nodes in the current level.
            int size = q.size();

            // Stores all nodes of the current level.
            List<Integer> level = new ArrayList<>();

            // Process one complete level.
            for (int i = 0; i < size; i++) {

                // Remove the front node.
                TreeNode node = q.poll();

                // If direction is Left to Right,
                // insert at the end.
                if (leftToRight)
                    level.add(node.val);

                // If direction is Right to Left,
                // insert at the beginning.
                else
                    level.add(0, node.val);

                // Add the left child to the queue.
                if (node.left != null)
                    q.offer(node.left);

                // Add the right child to the queue.
                if (node.right != null)
                    q.offer(node.right);
            }

            // Store the current level.
            ans.add(level);

            // Reverse the direction
            // for the next level.
            leftToRight = !leftToRight;
        }

        // Return the final answer.
        return ans;
    }
}
