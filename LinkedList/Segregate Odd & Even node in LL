class Solution {
    public ListNode oddEvenList(ListNode head) {

        if (head == null || head.next == null)
            return head;                               // Empty list or only one node

        ListNode odd = head;                           // Points to odd-position nodes

        ListNode even = head.next;                     // Points to even-position nodes

        ListNode evenHead = even;                      // Save the first even node, we'll need it later

        while (even != null && even.next != null) {   // Continue until there are no more even nodes

            odd.next = odd.next.next;                  // Connect current odd to next odd
                                                       // Can also be written as: odd.next = even.next;

            odd = odd.next;                            // Move odd pointer to next odd node

            even.next = even.next.next;                // Connect current even to next even
                                                       // Can also be written as: even.next = odd.next;

            even = even.next;                          // Move even pointer to next even node
        }

        odd.next = evenHead;                           // Attach the even list after the odd list

        return head;                                   // Return the modified linked list
    }
}
Time Complexity  : O(n)   // Traverse the linked list only once
Space Complexity : O(1)   // Only a constant number of pointers are used
