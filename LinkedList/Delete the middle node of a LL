class Solution {
    public ListNode deleteMiddle(ListNode head) {

        if (head == null || head.next == null)
            return null;                          // Empty list or single node

        ListNode slow = head;                     // Will stop before the middle
        ListNode fast = head.next.next;           // Start fast two steps ahead

        while (fast != null && fast.next != null) {

            slow = slow.next;                     // Move slow by one step

            fast = fast.next.next;                // Move fast by two steps
        }

        slow.next = slow.next.next;               // Delete the middle node

        return head;                              // Return modified list
    }
}
Time Complexity: O(n/2)
Space Complexity: O(1)
