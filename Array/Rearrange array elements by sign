class Solution {
    public int[] rearrangeArray(int[] nums) {

        int n = nums.length; // size of array

        int[] ans = new int[n]; // new array to store result

        int posindex = 0; // even index → for positive numbers
        int negindex = 1; // odd index → for negative numbers

        // Traverse the input array
        for (int i = 0; i < n; i++) {

            // If current number is positive
            if (nums[i] > 0) {

                // Place it at even index
                ans[posindex] = nums[i];

                // Move to next even index
                posindex += 2;
            }

            // If current number is negative
            else {

                // Place it at odd index
                ans[negindex] = nums[i];

                // Move to next odd index
                negindex += 2;
            }
        }

        // Return rearranged array
        return ans;
    }
}
//TC:O(N)
//SC:O(N)
