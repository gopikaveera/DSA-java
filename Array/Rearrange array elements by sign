import java.util.*;
class Solution {
    public int[] rearrangeArray(int[] nums) {

        int n = nums.length;

        // Step 1: store positives and negatives separately
        List<Integer> pos = new ArrayList<>();
        List<Integer> neg = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            if (nums[i] > 0) {
                pos.add(nums[i]);
            } else {
                neg.add(nums[i]);
            }
        }

        // Step 2: create result array
        int[] arr = new int[n];

        int i = 0; // index for result array
        int p = 0; // index for pos list
        int ne = 0; // index for neg list

        // Step 3: alternate elements
        while (p < pos.size() && ne < neg.size()) {

            arr[i] = pos.get(p); // place positive
            i++;
            p++;

            arr[i] = neg.get(ne); // place negative
            i++;
            ne++;
        }

        // Step 4: add remaining positives
        while (p < pos.size()) {
            arr[i] = pos.get(p);
            i++;
            p++;
        }

        // Step 5: add remaining negatives
        while (ne < neg.size()) {
            arr[i] = neg.get(ne);
            i++;
            ne++;
        }

        return arr;
    }
}
