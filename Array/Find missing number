public class Solution {
    public static int missingNumber(int []a, int N) {
        int sum=N*(N+1)/2; //formula for sum of 1st n natural numbers
        int count=0;
        for(int i=0;i<N-1;i++){
            count+=a[i];
        }
        return sum-count; //it will give the missing number
    }
   
}
//Tc: O(N)   ,Sc: O(1)

